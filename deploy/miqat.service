# systemd unit for the miqat server. Install the binary with
#   cargo install --git https://github.com/sharno/miqat
# put your config at /etc/miqat/config.toml, then:
#   sudo cp deploy/miqat.service /etc/systemd/system/ && sudo systemctl enable --now miqat
[Unit]
Description=miqat Kindle dashboard renderer
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/miqat --config /etc/miqat/config.toml serve
DynamicUser=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
